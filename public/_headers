# Vite fingerprints everything in /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell must always revalidate so new deploys show up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The section pages should also pick up edits right away.
/guide.html
  Cache-Control: no-cache
/postcards.html
  Cache-Control: no-cache
/add-it-up.html
  Cache-Control: no-cache
/pages.css
  Cache-Control: no-cache
/pages.js
  Cache-Control: no-cache
