{
  // Static site served by a Cloudflare Worker (assets only, no Worker script).
  "name": "tbhome",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html (200). Switch to "404-page" if you'd rather 404.
    "not_found_handling": "single-page-application"
  }
}
